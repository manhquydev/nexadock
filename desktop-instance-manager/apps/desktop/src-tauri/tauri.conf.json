{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi-Zalo Desktop",
  "version": "0.1.0",
  "identifier": "com.multizalodesktop.manager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multi-Zalo Desktop — Instance Manager",
        "width": 1160,
        "height": 780,
        "minWidth": 420,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"
    }
  }
}
