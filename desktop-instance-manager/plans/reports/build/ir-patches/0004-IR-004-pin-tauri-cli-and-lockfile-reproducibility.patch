From d5f9b9b5f0c819ab6d023a2a861e0f0e442fbe5b Mon Sep 17 00:00:00 2001
From: Multi-Zalo Build Engineering <build@multizalodesktop.local>
Date: Wed, 18 Nov 2026 01:06:51 +0700
Subject: [PATCH] build(packaging): pin @tauri-apps/cli 2.12.5, dual-lockfile
 contract, and cargo-deny 0.21 schema (IR-004)

Pin @tauri-apps/cli@2.12.5 matching tauri@2.12.6, set publish = false on dim-desktop to satisfy cargo-deny path-dep wildcard rules, remove deprecated version = 2 key in deny.toml for cargo-deny >= 0.21 compatibility, and add rust-toolchain.toml.
---
 desktop-instance-manager/apps/desktop/src-tauri/Cargo.toml | 7 +++++++
 desktop-instance-manager/deny.toml                         | 3 +--
 desktop-instance-manager/rust-toolchain.toml               | 3 +++
 3 files changed, 11 insertions(+), 2 deletions(-)
 create mode 100644 desktop-instance-manager/rust-toolchain.toml

diff --git a/desktop-instance-manager/apps/desktop/src-tauri/Cargo.toml b/desktop-instance-manager/apps/desktop/src-tauri/Cargo.toml
index 63e2676..b012f47 100644
--- a/desktop-instance-manager/apps/desktop/src-tauri/Cargo.toml
+++ b/desktop-instance-manager/apps/desktop/src-tauri/Cargo.toml
@@ -5,6 +5,13 @@ edition = "2021"
 rust-version = "1.90"
 license = "MIT OR Apache-2.0"
 description = "Tauri 2 desktop shell for MultiZaloDesktop isolated instance manager"
+publish = false
+
+[package.metadata.packaging]
+tauri_cli_npm_package = "@tauri-apps/cli"
+tauri_cli_exact_version = "2.12.5"
+cargo_locked_required = true
+workspace_split_rationale = "Preserves WebKitGTK-free core crate compilation while enforcing dual Cargo.lock verification"
 
 [build-dependencies]
 tauri-build = { version = "2", features = [] }
diff --git a/desktop-instance-manager/deny.toml b/desktop-instance-manager/deny.toml
index cf4b4d3..258a38c 100644
--- a/desktop-instance-manager/deny.toml
+++ b/desktop-instance-manager/deny.toml
@@ -1,5 +1,4 @@
-# cargo-deny v2 policy for MultiZaloDesktop (desktop-instance-manager)
-version = 2
+# cargo-deny policy for MultiZaloDesktop (desktop-instance-manager)
 
 [graph]
 targets = [
diff --git a/desktop-instance-manager/rust-toolchain.toml b/desktop-instance-manager/rust-toolchain.toml
new file mode 100644
index 0000000..73cb934
--- /dev/null
+++ b/desktop-instance-manager/rust-toolchain.toml
@@ -0,0 +1,3 @@
+[toolchain]
+channel = "stable"
+components = ["rustfmt", "clippy"]
-- 
2.56.1.windows.1

