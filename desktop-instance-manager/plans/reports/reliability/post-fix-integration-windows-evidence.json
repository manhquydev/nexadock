        ],
        "defect_id": "DEFECT-01",
        "minimal_reproduction": "Create a Chromium-style dangling symlink `ln -s ubuntu-host-99999 .config/ZaloData/SingletonLock` (without JSON `lockfile`) for a dead PID `99999` and call `inspect_profile`: `singleton_lock.exists()` follows the dangling target and returns `false`, so `stale_lock_detected` is `false` and `StaleLockRecoveryManager` is skipped on relaunch!",
        "observed_evidence": {
          "appimage_status": "experimental",
          "dangling_singleton_lock_uses_path_exists": true,
          "host_os": "windows",
          "native_runtime_verified": false,
          "official_linux_status": "unsupported",
          "required_native_os": "linux",
          "verification_kind": "STATIC_CONFIRMED_NON_HOST"
        },
        "severity": "HIGH",
        "summary": "macOS and Linux adapters check `singleton_lock.exists()` instead of `fs::symlink_metadata()`, failing to detect Chromium's dangling `SingletonLock` (`<hostname>-<pid>`) symlinks after a crash.",
        "test_case_ids": [
          "XP-LNX-02"
        ]
      },
      {
        "affected_files": [
          "crates/platform-macos/src/adapter.rs:192-196,298,305-320",
          "crates/platform-windows/src/adapter.rs:600-607,620-629"
        ],
        "defect_id": "DEFECT-02",
        "minimal_reproduction": "On macOS, launch 2 `NodeFixture` profiles without explicit `--user-id`: `MacOsPlatformAdapter::launch` neither derives a per-profile `--user-id` (both default to `100001`, colliding on `DUPLICATE_ZALO_USER_ID`) nor polls readiness nor reads `.runtime-pid` in `inspect_profile`, and uses `singleton_lock.exists()` which returns `false` on Chromium's dangling `SingletonLock` symlinks.",
        "observed_evidence": {
          "host_os": "windows",
          "missing_deterministic_fixture_user_id": true,
          "native_runtime_verified": false,
          "required_native_os": "macos",
          "singleton_lock_uses_path_exists_bug": true,
          "verification_kind": "STATIC_CONFIRMED_NON_HOST",
          "writes_runtime_pid_but_never_reads_it": true
        },
        "severity": "HIGH",
        "summary": "macOS and Linux adapters neither read `.runtime-pid` nor inject deterministic fixture `--user-id` nor poll readiness on launch, causing false `running=false` right after spawn and `DUPLICATE_ZALO_USER_ID` collisions on multi-profile `NodeFixture` launches.",
        "test_case_ids": [
          "XP-MAC-03"
        ]
      }
    ],
