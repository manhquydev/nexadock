{
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Isolated multi-instance desktop profile manager for Zalo (zero VNG binaries bundled)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "../../../scripts/ci-cross-platform/assets/128x128@2x.png",
      "../../../scripts/ci-cross-platform/assets/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      }
    }
  }
}
