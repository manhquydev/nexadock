---
import { SITE_COPY, type Lang } from '../data/site-copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const sc = SITE_COPY[lang].showcase;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="showcase-shell" id="workspace-showcase" aria-label={sc.title}>
  <div class="showcase-chrome">
    <div class="showcase-brand">
      <img src={`${base}/brand/nexadock-mark.svg`} alt="" width="16" height="16" />
      <span>NexaDock</span>
    </div>
    <span class="showcase-demo-label">{sc.note}</span>
  </div>

  <div class="showcase-body">
    <div class="showcase-rail" role="tablist" aria-label={sc.title}>
      {sc.accounts.map((acc, idx) => (
        <button
          type="button"
          class={`rail-item ${idx === 1 ? 'is-active' : ''}`}
          role="tab"
          id={`showcase-tab-${acc.id}`}
          aria-controls={`showcase-panel-${acc.id}`}
          aria-selected={idx === 1 ? 'true' : 'false'}
          tabindex={idx === 1 ? '0' : '-1'}
          data-showcase-tab={acc.id}
        >
          <span class={`rail-avatar ${acc.id === 'primary' ? 'is-primary' : ''}`}>{acc.initials}</span>
          <span class="rail-meta">
            <span class="rail-name">{acc.name}</span>
            <span class="rail-role">{acc.role}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="showcase-stage">
      {sc.accounts.map((acc, idx) => (
        <div
          class="stage-pane"
          role="tabpanel"
          id={`showcase-panel-${acc.id}`}
          aria-labelledby={`showcase-tab-${acc.id}`}
          data-showcase-panel={acc.id}
          hidden={idx !== 1}
        >
          <div class="stage-head">
            <div>
              <p class="stage-name">{acc.name}</p>
              <p class="stage-role">{acc.role}</p>
            </div>
            <span class={`state-tag ${acc.stateKind === 'ok' ? 'is-ok' : 'is-neutral'}`}>{acc.state}</span>
          </div>
          <p class="stage-detail">{acc.detail}</p>
          <div class="stage-path-box">
            <span class="stage-path-label">{lang === 'vi' ? 'Thư mục cô lập' : 'Isolated path'}</span>
            <code class="stage-path-code">{acc.path}</code>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .showcase-shell {
    background: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-frame);
    overflow: hidden;
  }

  .showcase-chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 12px 16px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
  }

  .showcase-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .showcase-demo-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .showcase-body {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: 290px;
  }

  @media (max-width: 640px) {
    .showcase-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .showcase-rail {
    display: grid;
    gap: 4px;
    padding: var(--space-3);
    background: var(--bg-page);
    border-right: 1px solid var(--border);
    align-content: start;
  }

  @media (max-width: 640px) {
    .showcase-rail {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }

  .rail-item {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 12px;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-family: var(--font-sans);
    color: var(--text-primary);
  }

  .rail-item:active {
    transform: translateY(1px);
  }

  .rail-item:hover {
    background: var(--bg-hover);
  }

  .rail-item.is-active {
    background: var(--bg-surface);
    border-color: var(--accent);
  }

  .rail-avatar {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--accent);
    color: var(--accent-text);
  }

  .rail-avatar.is-primary {
    background: var(--bg-subtle);
    color: var(--text-primary);
    border: 1px solid var(--border-strong);
  }

  .rail-meta {
    display: grid;
    min-width: 0;
  }

  .rail-name {
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rail-role {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .showcase-stage {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .stage-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .stage-name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .stage-role {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .stage-detail {
    margin: 0 0 var(--space-4);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .stage-path-box {
    padding: var(--space-3);
    background: var(--bg-page);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .stage-path-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .stage-path-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    word-break: break-all;
    color: var(--text-primary);
  }
</style>

<script is:inline>
  const tabs = Array.from(document.querySelectorAll('[data-showcase-tab]'));
  const panels = document.querySelectorAll('[data-showcase-panel]');
  function activateShowcaseTab(tab, focusTab = false) {
    const target = tab.getAttribute('data-showcase-tab');
    tabs.forEach((t) => {
      const active = t.getAttribute('data-showcase-tab') === target;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', String(active));
      t.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach((p) => {
      p.hidden = p.getAttribute('data-showcase-panel') !== target;
    });
    if (focusTab) tab.focus();
  }
  tabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => activateShowcaseTab(tab));
    tab.addEventListener('keydown', (e) => {
      let nextIdx = null;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = tabs.length - 1;
      if (nextIdx !== null) {
        e.preventDefault();
        activateShowcaseTab(tabs[nextIdx], true);
      }
    });
  });
</script>
