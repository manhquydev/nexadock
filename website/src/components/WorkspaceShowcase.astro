---
import { SITE_COPY, type Lang } from '../data/site-copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const library = SITE_COPY[lang].workflowLibrary;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="showcase-section" aria-labelledby="workflow-library-title">
  <header class="showcase-intro">
    <h1 id="workflow-library-title">{library.title}</h1>
    <p>{library.description}</p>
  </header>

  <div class="showcase-shell" id="workspace-showcase">
    <div class="showcase-chrome">
      <div class="showcase-brand">
        <img src={`${base}/brand/nexadock-mark.svg`} alt="" width="16" height="16" />
        <span>NexaDock</span>
        <span class="showcase-section-label">{library.eyebrow}</span>
      </div>
      <p class="showcase-sample-label">{library.sampleLabel}</p>
    </div>
  

    <div class="showcase-body">
      <div class="showcase-rail" role="tablist" aria-label={library.title} aria-orientation="vertical">
        {library.items.map((item, idx) => (
          <button
            type="button"
            class={`rail-item ${idx === 0 ? 'is-active' : ''}`}
            role="tab"
            id={`workflow-tab-${item.id}`}
            aria-controls={`workflow-panel-${item.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            tabindex={idx === 0 ? '0' : '-1'}
            data-workflow-tab={item.id}
          >
            <span class="rail-number" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
            <span class="rail-meta">
              <span class="rail-name">{item.label}</span>
              <span class="rail-status">
                <span
                  class={`state-led state-led--${item.state}`}
                  aria-hidden="true"
                ></span>
                {item.stateLabel}
              </span>
            </span>
          </button>
        ))}
      </div>

      <div class="showcase-stage">
        {library.items.map((item, idx) => (
          <article
            class="stage-pane"
            role="tabpanel"
            id={`workflow-panel-${item.id}`}
            aria-labelledby={`workflow-tab-${item.id}`}
            tabindex="0"
            data-workflow-panel={item.id}
            hidden={idx !== 0}
          >
            <div class="stage-content">
              <div class="stage-head">
                <h3 class="stage-title">{item.title}</h3>
                <span class="stage-status">
                  <span
                    class={`state-led state-led--${item.state}`}
                    aria-hidden="true"
                  ></span>
                  {item.stateLabel}
                </span>
              </div>

              <p class="stage-description">{item.body}</p>

              <ol class="stage-steps">
                {item.steps.map((step) => <li>{step}</li>)}
              </ol>
            </div>

            <footer class="stage-footer">
              <p class="stage-footnote">{item.footnote}</p>
              <a class="btn btn-primary stage-action" href={item.actionHref}>{item.actionLabel}</a>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>

  .showcase-section {
    min-width: 0;
  }

  .showcase-intro {
    max-width: 54rem;
    margin-bottom: var(--space-4);
  }

  .showcase-intro h1 {
    margin: 0 0 var(--space-2);
    color: var(--nd-ink);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .showcase-intro p {
    max-width: 65ch;
    margin: 0;
    color: var(--nd-ink-2);
    line-height: 1.6;
  }

  .showcase-shell {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--nd-panel);
    box-shadow: var(--shadow-frame);
  }

  .showcase-chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--nd-line);
    background: var(--nd-raised);
  }

  .showcase-brand {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--nd-ink);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .showcase-section-label {
    color: var(--nd-ink-2);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .showcase-sample-label {
    max-width: 46rem;
    margin: 0;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--status-warn-border);
    border-radius: var(--radius-sm);
    background: var(--status-warn-bg);
    color: var(--status-warn-fg);
    font-size: 0.8125rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .state-led {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: transparent;
  }

  .state-led--running {
    color: var(--nd-led-running);
    background: var(--nd-led-running);
  }

  .state-led--experimental {
    color: var(--nd-led-attention);
    background: var(--nd-led-attention);
  }

  .state-led--idle {
    color: var(--nd-led-idle);
  }

  .showcase-body {
    display: grid;
    grid-template-columns: minmax(13rem, 0.72fr) minmax(0, 1.28fr);
    min-height: 22rem;
  }

  .showcase-rail {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-3);
    border-right: 1px solid var(--nd-line);
    background: var(--nd-bg);
  }

  .rail-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--nd-ink);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .rail-item:hover {
    border-color: var(--nd-line);
    background: var(--nd-raised);
  }

  .rail-item.is-active {
    border-color: var(--border-strong);
    background: var(--nd-panel);
  }

  .rail-item:focus-visible {
    outline: 2px solid var(--nd-cta);
    outline-offset: 2px;
  }

  .rail-number {
    flex: none;
    padding-top: 1px;
    color: var(--nd-ink-2);
    font-family: var(--nd-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .rail-meta {
    display: grid;
    min-width: 0;
    gap: var(--space-1);
  }

  .rail-name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .rail-status,
  .stage-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--nd-ink-2);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .showcase-stage {
    display: flex;
    min-width: 0;
    padding: clamp(var(--space-4), 3vw, var(--space-6));
  }

  .stage-pane {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-width: 0;
  }

  .stage-pane[hidden] {
    display: none;
  }

  .stage-pane:focus-visible {
    outline: 2px solid var(--nd-cta);
    outline-offset: 4px;
  }

  .stage-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .stage-title {
    min-width: 0;
    margin: 0;
    color: var(--nd-ink);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }

  .stage-description {
    max-width: 65ch;
    margin: 0 0 var(--space-4);
    color: var(--nd-ink-2);
    line-height: 1.6;
  }

  .stage-steps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-inline-start: 1.5rem;
    color: var(--nd-ink);
    line-height: 1.55;
  }

  .stage-steps li {
    padding-inline-start: var(--space-1);
  }

  .stage-steps li::marker {
    color: var(--nd-ink-2);
    font-family: var(--nd-mono);
    font-size: 0.8125rem;
  }

  .stage-footer {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--nd-line);
  }

  .stage-footnote {
    margin: 0;
    color: var(--nd-ink-2);
    font-size: 0.8125rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .stage-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    max-width: 100%;
    text-align: center;
  }

  @media (max-width: 767px) {
    .showcase-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase-rail {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      border-right: 0;
      border-bottom: 1px solid var(--nd-line);
      scrollbar-color: var(--nd-ink-2) var(--nd-bg);
      scrollbar-width: thin;
    }

    .rail-item {
      flex: 0 0 min(15rem, 78vw);
      min-height: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-item {
      transition: none;
    }
  }
</style>
<script is:inline>
  const shell = document.getElementById('workspace-showcase');
  const tabs = Array.from(shell?.querySelectorAll('[data-workflow-tab]') ?? []);
  const panels = Array.from(shell?.querySelectorAll('[data-workflow-panel]') ?? []);
  const rail = shell?.querySelector('[role="tablist"]');
  const mobileRail = window.matchMedia('(max-width: 767px)');
  const setRailOrientation = () => {
    rail?.setAttribute('aria-orientation', mobileRail.matches ? 'horizontal' : 'vertical');
  };
  setRailOrientation();
  mobileRail.addEventListener('change', setRailOrientation);

  function activateWorkflowTab(tab, moveFocus = false) {
    const target = tab.getAttribute('data-workflow-tab');
    tabs.forEach((item) => {
      const active = item === tab;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-selected', String(active));
      item.setAttribute('tabindex', active ? '0' : '-1');
    });
    panels.forEach((panel) => {
      panel.hidden = panel.getAttribute('data-workflow-panel') !== target;
    });
    if (moveFocus) tab.focus();
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateWorkflowTab(tab));
    tab.addEventListener('keydown', (event) => {
      let nextIndex = null;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        nextIndex = (index + 1) % tabs.length;
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        nextIndex = (index - 1 + tabs.length) % tabs.length;
      } else if (event.key === 'Home') {
        nextIndex = 0;
      } else if (event.key === 'End') {
        nextIndex = tabs.length - 1;
      }
      if (nextIndex !== null) {
        event.preventDefault();
        activateWorkflowTab(tabs[nextIndex], true);
      }
    });
  });
</script>

