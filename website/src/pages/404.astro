---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout lang="vi" title="404 | NexaDock" canonicalPath="/404.html">
  <section class="section" style="border-top: 0; padding-block: 96px;">
    <div class="container" style="max-width: 600px;">
      <h1 class="section-title">Không tìm thấy trang (404)</h1>
      <p class="section-desc" style="margin-bottom: 24px;">
        Đường dẫn bạn truy cập không tồn tại trên trang NexaDock.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a class="btn btn-primary" href={`${base}/`}>Trang chủ (Tiếng Việt)</a>
        <a class="btn btn-secondary" href={`${base}/en/`}>English Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
