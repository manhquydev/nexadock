---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_COPY } from '../../../data/site-copy';
import release from '../../../data/release.json';

const copy = SITE_COPY.en;
const winVerifyCmd = `Get-FileHash .\\NexaDock-${release.version}-windows-x64-* -Algorithm SHA256`;
const macVerifyCmd = `shasum -a 256 NexaDock-${release.version}-macos-arm64.dmg`;
const bridgeCmd = 'node apps/desktop/ui-server.mjs';
const winProfilesPath = '%LOCALAPPDATA%\\NexaDock\\Profiles';
const winPrimaryPath = '%APPDATA%\\ZaloData';
const macProfilesPath = '~/Library/Application Support/NexaDock/Profiles';
const macPrimaryPath = '~/Library/Application Support/ZaloData';
---
<BaseLayout
  lang="en"
  title={copy.docsTitle}
  description={copy.docsDescription}
  canonicalPath="/en/docs/"
  altPath="/docs/"
>
  <section class="section section--page-top">
    <div class="container container--narrow">
      <h1 class="section-title section-title--page">
        NexaDock Installation &amp; Operations Guide
      </h1>
      <p class="section-desc section-desc--spaced">
        Current published build: <strong>{release.tag}</strong> ({release.signingStatus}).
      </p>

      <div class="mechanism-list">
        <div class="mechanism-row">
          <h2>1. Windows Installation &amp; SHA-256 Verification</h2>
          <div class="mechanism-stack">
            <p>
              Download <span class="code-inline">NexaDock-{release.version}-windows-x64-setup.exe</span> or <span class="code-inline">.msi</span> from the home page, then verify its SHA-256 hash against <span class="code-inline">SHA256SUMS.txt</span> before running.
            </p>
            <div class="cmd-block">
              <code>{winVerifyCmd}</code>
              <button type="button" class="cmd-copy-btn" data-copy-cmd={winVerifyCmd} data-label-default="Copy" data-label-copied="Copied">
                Copy
              </button>
            </div>
          </div>
        </div>

        <div class="mechanism-row">
          <h2>2. Smart App Control (SAC=1) Signed-Host Bridge</h2>
          <div class="mechanism-stack">
            <p>
              On Windows 11 machines with Smart App Control enabled, keep SAC turned on and launch the UI through system-signed Node.js and PowerShell from <span class="code-inline">desktop-instance-manager</span>:
            </p>
            <div class="cmd-block">
              <code>{bridgeCmd}</code>
              <button type="button" class="cmd-copy-btn" data-copy-cmd={bridgeCmd} data-label-default="Copy" data-label-copied="Copied">
                Copy
              </button>
            </div>
          </div>
        </div>

        <div class="mechanism-row">
          <h2>3. macOS (arm64) Checksum Verification</h2>
          <div class="mechanism-stack">
            <p>
              The Apple Silicon <span class="code-inline">.dmg</span> is unsigned and unnotarized until Apple Developer secrets are configured. Always verify the SHA-256 checksum before opening:
            </p>
            <div class="cmd-block">
              <code>{macVerifyCmd}</code>
              <button type="button" class="cmd-copy-btn" data-copy-cmd={macVerifyCmd} data-label-default="Copy" data-label-copied="Copied">
                Copy
              </button>
            </div>
          </div>
        </div>

        <div class="mechanism-row">
          <h2>4. Profile Isolation &amp; Primary Zalo Protection</h2>
          <div class="mechanism-stack">
            <p>
              Each secondary account receives its own isolated directory (with dedicated <span class="code-inline">APPDATA</span>, <span class="code-inline">LOCALAPPDATA</span>, and <span class="code-inline">TEMP</span> paths on Windows). Your primary Zalo directory remains strictly read-only:
            </p>
            <ul>
              <li>
                <strong>Windows:</strong> secondary profiles at <span class="code-inline">{winProfilesPath}</span>; primary Zalo at <span class="code-inline">{winPrimaryPath}</span>.
              </li>
              <li>
                <strong>macOS:</strong> secondary profiles at <span class="code-inline">{macProfilesPath}</span>; primary Zalo at <span class="code-inline">{macPrimaryPath}</span>.
              </li>
            </ul>
            <p>
              When upgrading from <span class="code-inline">MultiZaloDesktop</span> to <span class="code-inline">NexaDock</span>, the app performs a one-time automatic migration of settings and profile data to the new path while preserving legacy data without auto-deletion.
            </p>
            <div class="cmd-block">
              <code>{winProfilesPath}</code>
              <button type="button" class="cmd-copy-btn" data-copy-cmd={winProfilesPath} data-label-default="Copy" data-label-copied="Copied">
                Copy
              </button>
            </div>
          </div>
        </div>

        <div class="mechanism-row">
          <h2>5. Diagnostics &amp; Recovery</h2>
          <div class="mechanism-stack">
            <p>
              Use the built-in Diagnostics screen to inspect client discovery, official binary signature checks, and sanitized logs. Guards such as <span class="code-inline">PROTECTED_PRIMARY_PROCESS</span> and <span class="code-inline">PROTECTED_PRIMARY_PATH</span> confirm that primary Zalo protection is active.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
