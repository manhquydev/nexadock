---
import '../styles/tokens.css';
import '../styles/global.css';
import { SITE_COPY, type Lang } from '../data/site-copy';
import release from '../data/release.json';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  canonicalPath?: string;
  altPath?: string;
  noindex?: boolean;
}

const { lang, title, description, canonicalPath = '/', altPath, noindex = false } = Astro.props;
const copy = SITE_COPY[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = 'https://manhquydev.github.io';
const pageTitle = title || copy.title;
const pageDesc = description || copy.description;
const canonicalUrl = `${siteOrigin}${base}${canonicalPath}`;
const ogImageUrl = `${siteOrigin}${base}/og-preview.png`;

const homeHref = lang === 'vi' ? `${base}/` : `${base}/en/`;
const docsHref = lang === 'vi' ? `${base}/docs/` : `${base}/en/docs/`;
const viHref = lang === 'vi' ? `${base}${canonicalPath}` : `${base}${altPath || '/'}`;
const enHref = lang === 'en' ? `${base}${canonicalPath}` : `${base}${altPath || '/en/'}`;

const viAbsoluteUrl = lang === 'vi' ? canonicalUrl : `${siteOrigin}${base}${altPath || '/'}`;
const enAbsoluteUrl = lang === 'en' ? canonicalUrl : `${siteOrigin}${base}${altPath || '/en/'}`;
const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';
const ogAltLocale = lang === 'vi' ? 'en_US' : 'vi_VN';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="vi" href={viAbsoluteUrl} />
        <link rel="alternate" hreflang="en" href={enAbsoluteUrl} />
        <link rel="alternate" hreflang="x-default" href={viAbsoluteUrl} />
      </>
    )}

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate icon" href={`${base}/favicon.ico`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NexaDock" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === 'vi' ? 'Chuyển đến nội dung chính' : 'Skip to main content'}
    </a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand-link" href={homeHref}>
          <img src={`${base}/brand/nexadock-mark.svg`} alt="" width="24" height="24" />
          <span>NexaDock</span>
        </a>

        <nav class="nav-links" aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Primary navigation'}>
          <a href={`${homeHref}#experience`}><span class="nav-num" aria-hidden="true">01</span>{copy.nav.experience}</a>
          <a href={`${homeHref}#safety`}><span class="nav-num" aria-hidden="true">02</span>{copy.nav.safety}</a>
          <a href={`${homeHref}#platforms`}><span class="nav-num" aria-hidden="true">03</span>{copy.nav.platforms}</a>
          <a href={`${homeHref}#download`}><span class="nav-num" aria-hidden="true">04</span>{copy.nav.download}</a>
          <a href={docsHref}><span class="nav-num" aria-hidden="true">05</span>{copy.nav.docs}</a>
        </nav>

        <div class="header-actions">
          <div class="lang-switch" role="group" aria-label={lang === 'vi' ? 'Ngôn ngữ' : 'Language'}>
            <a href={viHref} aria-current={lang === 'vi' ? 'page' : undefined}>VI</a>
            <a href={enHref} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <a
            class="releases-link"
            href="https://github.com/manhquydev/nexadock/releases"
            target="_blank"
            rel="noopener noreferrer"
          >
            Releases
          </a>
          <button
            type="button"
            class="mobile-menu-btn"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-drawer"
          >
            {copy.nav.menu}
          </button>
        </div>
      </div>

      <div class="mobile-drawer" id="mobile-drawer">
        <a href={`${homeHref}#experience`}>{copy.nav.experience}</a>
        <a href={`${homeHref}#safety`}>{copy.nav.safety}</a>
        <a href={`${homeHref}#platforms`}>{copy.nav.platforms}</a>
        <a href={`${homeHref}#download`}>{copy.nav.download}</a>
        <a href={docsHref}>{copy.nav.docs}</a>
        <a
          class="releases-link"
          href="https://github.com/manhquydev/nexadock/releases"
          target="_blank"
          rel="noopener noreferrer"
        >
          Releases
        </a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a class="brand-link" href={homeHref}>
            <img src={`${base}/brand/nexadock-mark.svg`} alt="" width="22" height="22" />
            <span>NexaDock</span>
          </a>
          <p class="footer-version">
            <a href={release.htmlUrl} style="color: inherit">{release.tag}</a> · {release.isPrerelease ? (lang === 'vi' ? 'Pre-release' : 'Pre-release') : (lang === 'vi' ? 'Bản phát hành' : 'Release')}
          </p>
          <p class="footer-disclaimer">{copy.footer.disclaimer}</p>
        </div>
        <div>
          <strong>{copy.footer.projectHeading}</strong>
          <ul class="footer-links">
            <li><a href="https://github.com/manhquydev/nexadock">GitHub Repository</a></li>
            <li><a href="https://github.com/manhquydev/nexadock/releases">GitHub Releases ({release.tag})</a></li>
            <li><a href="https://github.com/manhquydev/nexadock/issues">{lang === 'vi' ? 'Báo lỗi' : 'Report an Issue'}</a></li>
          </ul>
        </div>
        <div>
          <strong>{copy.footer.resourcesHeading}</strong>
          <ul class="footer-links">
            <li><a href={docsHref}>{copy.nav.docs}</a></li>
            <li><a href="https://github.com/manhquydev/nexadock/blob/main/CONTRIBUTING.md">Contributing</a></li>
            <li><a href="https://github.com/manhquydev/nexadock/blob/main/desktop-instance-manager/docs/architecture/ADR-001-unified-workspace.md">ADR-001</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <div class="sr-only" id="copy-announcer" aria-live="polite"></div>

    <script is:inline>
      const btn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-drawer');
      if (btn && drawer) {
        const closeDrawer = (restoreFocus = false) => {
          drawer.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          if (restoreFocus) btn.focus();
        };

        btn.addEventListener('click', () => {
          const open = drawer.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(open));
        });

        drawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => closeDrawer(false));
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            closeDrawer(true);
          }
        });
      }

      const announcer = document.getElementById('copy-announcer');
      const copyErrorMsg = document.documentElement.lang === 'vi'
        ? 'Không thể tự động sao chép. Vui lòng sao chép thủ công.'
        : 'Could not copy automatically. Please copy manually.';
      document.querySelectorAll('[data-copy-cmd]').forEach((copyBtn) => {
        copyBtn.addEventListener('click', async () => {
          const text = copyBtn.getAttribute('data-copy-cmd') || '';
          const defaultLabel = copyBtn.getAttribute('data-label-default') || 'Copy';
          const copiedLabel = copyBtn.getAttribute('data-label-copied') || 'Copied';
          try {
            await navigator.clipboard.writeText(text);
            copyBtn.textContent = copiedLabel;
            if (announcer) announcer.textContent = copiedLabel;
            setTimeout(() => {
              copyBtn.textContent = defaultLabel;
            }, 1800);
          } catch {
            if (announcer) announcer.textContent = copyErrorMsg;
          }
        });
      });
    </script>
  </body>
</html>
